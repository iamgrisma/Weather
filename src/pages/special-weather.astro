---
import BaseLayout from '../layouts/BaseLayout.astro';
import RefreshBar from '../components/RefreshBar.astro';
import SpecialWeatherCard from '../components/SpecialWeatherCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getEdgeEnv, getLatestSnapshot } from '../lib/storage/edge-storage';

export const prerender = false;

const env = getEdgeEnv(Astro.locals);
const snapshot = await getLatestSnapshot(env);

const title = 'Nepal Special Weather Warnings & Emergency Hazard Advisories | DHM MFD';
const description = 'Live special weather bulletins, flood emergency warnings, monsoon withdrawals, and 3-day graphical warning maps issued by Nepal Meteorological Forecasting Division.';
---

<BaseLayout title={title} description={description} lang="en">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-1.5">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-600">Special Weather Advisories</span>
    </div>
    <div class="flex items-center gap-2.5">
      <span class="inline-flex h-3.5 w-3.5 rounded-full bg-amber-500 animate-pulse"></span>
      <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
        Special Weather Warnings & Emergency Bulletins
      </h1>
    </div>
    <p class="text-sm font-semibold text-slate-500 mt-1">
      Official emergency warnings, severe monsoon advisories, winter cold waves, western disturbances, and multi-day hazard maps from MFD.
    </p>
  </div>

  <RefreshBar
    fetchedAt={snapshot.specialWeather?.fetchedAt || snapshot.fetchedAt}
    lastCheckedAt={snapshot.specialWeather?.lastCheckedAt || snapshot.lastCheckedAt}
    scope="special"
    lang="en"
  />

  <SpecialWeatherCard
    items={snapshot.specialWeather?.items || []}
    activeNotice={snapshot.specialWeather?.activeNotice || null}
    lang="en"
  />

  <!-- Ad Slot (Zero CLS) -->
  <AdSlot position="in-article" lang="en" />
</BaseLayout>
