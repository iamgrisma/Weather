---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RefreshBar from '../../components/RefreshBar.astro';
import MountainMap from '../../components/MountainMap.astro';
import MountaineeringMatrix from '../../components/MountaineeringMatrix.astro';
import TrekkingCorridors from '../../components/TrekkingCorridors.astro';
import TourismTable from '../../components/TourismTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getEdgeEnv, getLatestSnapshot } from '../../lib/storage/edge-storage';

export const prerender = true;

const env = getEdgeEnv(Astro.locals);
const snapshot = await getLatestSnapshot(env);

const title = 'नेपाल हिमाल आरोहण तथा उच्च हिमाली मौसम पूर्वानुमान (३०००-९००० मिटर) | DHM MFD';
const description = 'सगरमाथा, अन्नपूर्ण, मनास्लु, लाङटाङ लगायतका हिमाली क्षेत्रहरूको उचाई अनुसार हावाको गति, दिशा र माइनस तापक्रम।';
---

<BaseLayout title={title} description={description} lang="ne">
  <!-- Semantic Header -->
  <header class="mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-1">
      <a href="/ne" class="hover:underline">गृहपृष्ठ</a>
      <span>/</span>
      <span class="text-slate-600">हिमाल आरोहण मौसम</span>
    </div>
    <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
      हिमाल आरोहण तथा उच्च हिमाली मौसम पूर्वानुमान
    </h1>
    <p class="text-xs text-slate-500 mt-1">
      ३,००० मिटर, ५,५०० मिटर (आधार शिविर), ७,००० मिटर र ९,००० मिटर (शिखर) उचाई अनुसार हावाको दिशा, गति र तापक्रमको आधिकारिक विवरण।
    </p>
  </header>

  <RefreshBar
    fetchedAt={snapshot.mountaineeringWeather?.fetchedAt || snapshot.fetchedAt}
    lastCheckedAt={snapshot.mountaineeringWeather?.lastCheckedAt || snapshot.lastCheckedAt}
    scope="mountain"
    lang="ne"
  />

  <!-- Interactive High Himalayan Peaks & Observatories Map -->
  <MountainMap
    stations={snapshot.tourismWeather?.stations || []}
    divisions={snapshot.mountaineeringWeather?.data?.divisions || []}
    routes={snapshot.tourismWeather?.routes || []}
    lang="ne"
  />

  <!-- High Himalayan Mountaineering Telemetry Matrix -->
  <MountaineeringMatrix
    weather={snapshot.mountaineeringWeather?.data || null}
    lang="ne"
  />

  <!-- Ad Slot (Zero CLS) -->
  <AdSlot position="in-article" lang="ne" />

  <!-- Mountain Pass & Base Camp Meteorological Stations (Direct flat section) -->
  {snapshot.tourismWeather?.stations?.length > 0 && (
    <TourismTable stations={snapshot.tourismWeather.stations} lang="ne" />
  )}

  <!-- Major Trekking Routes & Corridors -->
  <TrekkingCorridors
    routes={snapshot.tourismWeather?.routes || []}
    lang="ne"
  />
</BaseLayout>
