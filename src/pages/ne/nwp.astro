---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RefreshBar from '../../components/RefreshBar.astro';
import NwpInteractiveMap from '../../components/NwpInteractiveMap.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getEdgeEnv, getLatestSnapshot } from '../../lib/storage/edge-storage';

export const prerender = false;

const env = getEdgeEnv(Astro.locals);
const snapshot = await getLatestSnapshot(env);

const title = 'संख्यात्मक मौसम पूर्वानुमान (NWP) तथा WRF मोडेलहरू | जल तथा मौसम विज्ञान विभाग';
const description = 'नेपाल सरकार मौसम पूर्वानुमान महाशाखाको जियोसर्भर मार्फत सञ्चालित GIDC WRF, WRFDA, GFS र UEMS वायुमण्डलीय मोडेलहरू।';
---

<BaseLayout title={title} description={description} lang="ne">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-1.5">
      <a href="/ne" class="hover:underline">गृहपृष्ठ</a>
      <span>/</span>
      <span class="text-slate-600">NWP मोडेलहरू</span>
    </div>
    <div class="flex items-center gap-2.5">
      <span class="inline-flex h-3.5 w-3.5 rounded-full bg-indigo-600"></span>
      <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
        संख्यात्मक मौसम पूर्वानुमान (NWP) तथा WRF मोडेलहरू
      </h1>
    </div>
    <p class="text-sm font-semibold text-slate-500 mt-1">
      नेपाल तथा हिमालय क्षेत्रका लागि तापमान, वर्षा, वायुको वेग र आर्द्रता सम्बन्धी आधुनिक कम्प्युटेशनल मोडलिङ उत्पादनहरू।
    </p>
  </div>

  <RefreshBar
    fetchedAt={snapshot.nwpModels?.fetchedAt || snapshot.fetchedAt}
    lastCheckedAt={snapshot.nwpModels?.lastCheckedAt || snapshot.lastCheckedAt}
    scope="nwp"
    lang="ne"
  />

  <!-- Interactive OpenStreetMap with DHM Geoserver WMS Radar Overlays -->
  <NwpInteractiveMap lang="ne" />

  <!-- Ad Slot (Zero CLS) -->
  <AdSlot position="in-article" lang="ne" />
</BaseLayout>
