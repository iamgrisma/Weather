---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RefreshBar from '../../components/RefreshBar.astro';
import ThreeDayBulletinCard from '../../components/ThreeDayBulletinCard.astro';
import FloodBulletins from '../../components/FloodBulletins.astro';
import { getEdgeEnv, getLatestSnapshot } from '../../lib/storage/edge-storage';

export const prerender = false;

const env = getEdgeEnv(Astro.locals);
const snapshot = await getLatestSnapshot(env);

const title = 'नेपाल ३ दिने मौसम पूर्वानुमान बुलेटिन तथा चेतावनी | DHM MFD';
const description = 'मौसम पूर्वानुमान महाशाखाद्वारा जारी आधिकारिक आगामी तीन दिनको मौसम पूर्वानुमान, नक्सा र सतर्कता सूचना।';
---

<BaseLayout title={title} description={description} lang="ne">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-1">
      <a href="/ne" class="hover:underline">गृहपृष्ठ</a>
      <span>/</span>
      <span class="text-slate-600">३ दिने बुलेटिन</span>
    </div>
    <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
      आधिकारिक आगामी तीन दिनको मौसम पूर्वानुमान बुलेटिन
    </h1>
    <p class="text-xs text-slate-500 mt-1">
      जल तथा मौसम विज्ञान विभाग, मौसम पूर्वानुमान महाशाखाद्वारा जारी दैनिक बिहान र साँझको आधिकारिक राष्ट्रिय मौसम विश्लेषण तथा चेतावनी।
    </p>
  </div>

  <RefreshBar
    fetchedAt={snapshot.threeDayBulletin?.fetchedAt || snapshot.fetchedAt}
    lastCheckedAt={snapshot.threeDayBulletin?.lastCheckedAt || snapshot.lastCheckedAt}
    scope="bulletin"
    lang="ne"
  />

  <!-- Three-Day Synoptic Weather Bulletin -->
  <ThreeDayBulletinCard
    bulletin={snapshot.threeDayBulletin?.data || null}
    lang="ne"
  />

  <!-- Hydrology Flood Bulletins -->
  <FloodBulletins
    bulletins={snapshot.bulletins?.items || []}
    lang="ne"
  />
</BaseLayout>
