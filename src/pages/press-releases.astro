---
import BaseLayout from '../layouts/BaseLayout.astro';
import RefreshBar from '../components/RefreshBar.astro';
import PressReleasesList from '../components/PressReleasesList.astro';
import AdSlot from '../components/AdSlot.astro';
import { getEdgeEnv, getLatestSnapshot } from '../lib/storage/edge-storage';

export const prerender = false;

const env = getEdgeEnv(Astro.locals);
const snapshot = await getLatestSnapshot(env);

const title = 'Official DHM Press Releases & Disaster Reports | Department of Hydrology & Meteorology';
const description = 'Official press releases, monsoon seasonal forecasts, flood assessments, and meteorological publications issued by Nepal DHM.';
---

<BaseLayout title={title} description={description} lang="en">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-1.5">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-600">Press Releases</span>
    </div>
    <div class="flex items-center gap-2.5">
      <span class="inline-flex h-3.5 w-3.5 rounded-full bg-blue-600"></span>
      <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
        Official DHM Press Releases & Publications
      </h1>
    </div>
    <p class="text-sm font-semibold text-slate-500 mt-1">
      Official government statements, extreme flood disaster investigations, seasonal forecasts, and downloadable PDF communiqués directly from DHM.
    </p>
  </div>

  <RefreshBar
    fetchedAt={snapshot.pressReleases?.fetchedAt || snapshot.fetchedAt}
    lastCheckedAt={snapshot.pressReleases?.lastCheckedAt || snapshot.lastCheckedAt}
    scope="press"
    lang="en"
  />

  <PressReleasesList
    items={snapshot.pressReleases?.items || []}
    lang="en"
  />

  <!-- Ad Slot (Zero CLS) -->
  <AdSlot position="in-article" lang="en" />
</BaseLayout>
