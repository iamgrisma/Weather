---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

export const prerender = true;

const title = 'Contact Us | Nepal Weather & River Watch Portal | Top Nepali';
const description = 'Get in touch with Nepal Weather portal editorial and technical team. Emergency flood hotlines, official DHM inquiry desks, and technical contact details.';
---

<BaseLayout title={title} description={description} lang="en">
  <!-- Semantic Header -->
  <header class="mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-1.5">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-600">Contact Us</span>
    </div>
    <div class="flex items-center gap-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white shadow-md shadow-blue-500/20">
        <Icon name="megaphone" class="w-5 h-5 text-white" />
      </span>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
        Contact &amp; Emergency Desks
      </h1>
    </div>
    <p class="text-xs sm:text-sm font-semibold text-slate-500 mt-1">
      Official emergency hotlines, hydrometeorological inquiry desks, and technical support channels.
    </p>
  </header>

  <!-- Emergency Hotlines Alert Box -->
  <section class="mb-8 rounded-2xl border-2 border-red-500 bg-red-50/70 p-6 sm:p-8 shadow-sm">
    <div class="flex items-start gap-3">
      <Icon name="alert-triangle" class="w-6 h-6 text-red-600 shrink-0 mt-0.5" />
      <div>
        <h2 class="text-base sm:text-lg font-black text-red-950 mb-1">
          Life-Safety &amp; Flood Emergencies (National Hotlines)
        </h2>
        <p class="text-xs sm:text-sm text-red-900 mb-4">
          If you or your community are facing immediate flood danger, flash floods, or landslide threats, contact government emergency desks immediately:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          <div class="rounded-xl border border-red-200 bg-white p-4 shadow-2xs">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Flood Toll-Free Hotline</span>
            <span class="text-2xl font-black text-red-600 block mt-1">1155</span>
            <span class="text-[11px] text-slate-500 mt-0.5 block">24/7 Department of Hydrology</span>
          </div>

          <div class="rounded-xl border border-red-200 bg-white p-4 shadow-2xs">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Disaster Emergency (NDRRMA)</span>
            <span class="text-2xl font-black text-red-600 block mt-1">1149</span>
            <span class="text-[11px] text-slate-500 mt-0.5 block">National Emergency Operations</span>
          </div>

          <div class="rounded-xl border border-red-200 bg-white p-4 shadow-2xs">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Nepal Police Emergency</span>
            <span class="text-2xl font-black text-red-600 block mt-1">100</span>
            <span class="text-[11px] text-slate-500 mt-0.5 block">National Rescue &amp; First Response</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Institutional & Media Contact Details -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-base sm:text-lg font-black text-slate-900 mb-3 flex items-center gap-2">
        <Icon name="city" class="w-5 h-5 text-blue-600" />
        <span>Official Forecast Desks (DHM / MFD)</span>
      </h2>
      <p class="text-xs text-slate-500 mb-4 leading-relaxed">
        For direct inquiries regarding official weather advisories, aviation meteorological forecasts, and mountain expedition permits:
      </p>

      <ul class="space-y-3 text-xs sm:text-sm">
        <li class="flex items-start gap-2.5">
          <Icon name="map-pin" class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" />
          <div>
            <strong>Meteorological Forecasting Division (MFD)</strong>
            <p class="text-xs text-slate-500">Tribhuvan International Airport, Sinamangal, Kathmandu, Nepal</p>
          </div>
        </li>
        <li class="flex items-center gap-2.5">
          <Icon name="info" class="w-4 h-4 text-slate-400 shrink-0" />
          <div>
            <strong>Forecast Phone:</strong>
            <span class="font-mono text-slate-700 ml-1">01-4113191 / 01-4113192</span>
          </div>
        </li>
        <li class="flex items-center gap-2.5">
          <Icon name="waves" class="w-4 h-4 text-slate-400 shrink-0" />
          <div>
            <strong>Flood Division:</strong>
            <span class="font-mono text-slate-700 ml-1">01-4259833 / Babarmahal</span>
          </div>
        </li>
      </ul>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-base sm:text-lg font-black text-slate-900 mb-3 flex items-center gap-2">
        <Icon name="lightbulb" class="w-5 h-5 text-amber-500" />
        <span>Top Nepali Portal &amp; Technical Inquiries</span>
      </h2>
      <p class="text-xs text-slate-500 mb-4 leading-relaxed">
        For technical bug reports, data integration inquiries, API access, or media partnerships regarding the Top Nepali digital network:
      </p>

      <div class="space-y-3 text-xs sm:text-sm">
        <div class="rounded-xl bg-slate-50 p-3.5 border border-slate-100">
          <span class="text-xs text-slate-400 block font-semibold">General &amp; Editorial Inquiries:</span>
          <a href="mailto:contact@topnepali.com" class="text-blue-600 font-bold hover:underline">contact@topnepali.com</a>
        </div>
        <div class="rounded-xl bg-slate-50 p-3.5 border border-slate-100">
          <span class="text-xs text-slate-400 block font-semibold">Digital Network:</span>
          <a href="https://topnepali.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 font-bold hover:underline">topnepali.com</a>
        </div>
        <p class="text-[11px] text-slate-400">
          We welcome collaboration with research bodies, humanitarian organizations, and local municipalities to enhance disaster resilience in Nepal.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
