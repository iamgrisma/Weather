---
import BaseLayout from '../layouts/BaseLayout.astro';
import RefreshBar from '../components/RefreshBar.astro';
import ThreeDayBulletinCard from '../components/ThreeDayBulletinCard.astro';
import FloodBulletins from '../components/FloodBulletins.astro';
import AdSlot from '../components/AdSlot.astro';
import { getEdgeEnv, getLatestSnapshot } from '../lib/storage/edge-storage';

export const prerender = false;

const env = getEdgeEnv(Astro.locals);
const snapshot = await getLatestSnapshot(env);

const title = 'Nepal 3-Day Synoptic Weather Bulletin & Hazard Advisories | DHM Official';
const description = 'Official meteorological analysis, warning advisories, and 3-day graphical synoptic maps issued by Nepal Department of Hydrology & Meteorology.';
---

<BaseLayout title={title} description={description} lang="en">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-1">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-600">3-Day Synoptic Bulletin</span>
    </div>
    <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
      Official 3-Day Synoptic Weather & Hazard Bulletin
    </h1>
    <p class="text-xs text-slate-500 mt-1">
      Twice-daily synoptic weather evaluations, disaster hazard advisories, and meteorologist graphical forecast maps from the Meteorological Forecasting Division (MFD).
    </p>
  </div>

  <RefreshBar
    fetchedAt={snapshot.threeDayBulletin?.fetchedAt || snapshot.fetchedAt}
    lastCheckedAt={snapshot.threeDayBulletin?.lastCheckedAt || snapshot.lastCheckedAt}
    scope="bulletin"
    lang="en"
  />

  <!-- Three-Day Synoptic Weather Bulletin -->
  <ThreeDayBulletinCard
    bulletin={snapshot.threeDayBulletin?.data || null}
    lang="en"
  />

  <!-- Ad Slot (Zero CLS) -->
  <AdSlot position="in-article" lang="en" />

  <!-- Hydrology Flood Bulletins -->
  <FloodBulletins
    bulletins={snapshot.bulletins?.items || []}
    lang="en"
  />
</BaseLayout>
