---
import type { DhmPressRelease } from '../lib/dhm/types';
import Icon from './Icon.astro';

interface Props {
  items: DhmPressRelease[];
  lang?: 'en' | 'ne';
  pageSize?: number;
}

const { items = [], lang = 'en', pageSize = 6 } = Astro.props;
const isNe = lang === 'ne';
---

<div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-sm mb-8" id="press-releases-component">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-100 pb-5 mb-5 gap-3">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="inline-flex h-3 w-3 rounded-full bg-blue-600"></span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
          {isNe ? 'जल तथा मौसम विज्ञान विभाग - आधिकारिक प्रेस विज्ञप्ति' : 'Official DHM Press Releases & Communiqués'}
        </h2>
      </div>
      <p class="text-xs sm:text-sm font-semibold text-slate-500 mt-1">
        {isNe ? 'मनसुन, बाढी, वायु प्रदूषण तथा आपतकालीन मौसमी सूचनाहरूको आधिकारिक अभिलेख' : 'Official releases on monsoon, flood disaster assessments, air quality and extreme events'}
      </p>
    </div>

    <div class="flex items-center gap-2">
      <span class="rounded-xl bg-slate-100 border border-slate-200 px-3.5 py-1.5 text-xs sm:text-sm font-bold text-slate-700">
        {items.length} {isNe ? 'विज्ञप्तिहरू' : 'Total Releases'}
      </span>
    </div>
  </div>

  {items.length > 0 ? (
    <div>
      <!-- Search / Filter Bar -->
      <div class="mb-4">
        <div class="relative">
          <input
            type="text"
            id="press-search-input"
            placeholder={isNe ? 'विज्ञप्ति खोज्नुहोस् (जस्तै: मनसुन, बाढी, हिउँद)...' : 'Search releases (e.g., monsoon, flood, advisory)...'}
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pl-10 text-xs sm:text-sm font-medium text-slate-900 focus:bg-white focus:border-blue-500 focus:outline-hidden transition shadow-2xs"
          />
          <span class="absolute left-3.5 top-3 text-slate-400">
            <Icon name="search" class="w-4 h-4 text-slate-400" />
          </span>
        </div>
      </div>

      <!-- Paginated Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="press-cards-grid">
        {items.map((item, idx) => (
          <div
            data-press-card
            data-index={idx}
            data-title={item.title.toLowerCase()}
            data-subtitle={(item.subtitle || '').toLowerCase()}
            class="press-item-card rounded-xl border border-slate-200 bg-slate-50/70 p-5 hover:border-blue-300 hover:shadow-xs transition flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="rounded-md bg-blue-100 text-blue-800 px-2 py-0.5 text-xs font-bold uppercase tracking-wider">
                  {isNe ? 'प्रेस विज्ञप्ति' : 'Press Release'}
                </span>
                {item.date && (
                  <span class="text-xs font-semibold text-slate-500 font-mono">
                    {item.date}
                  </span>
                )}
              </div>
              <h3 class="text-base sm:text-lg font-black text-slate-900 leading-snug mb-2">
                {item.title}
              </h3>
              {item.subtitle && item.subtitle !== item.title && (
                <p class="text-xs sm:text-sm text-slate-600 line-clamp-2 mb-4 font-normal">
                  {item.subtitle}
                </p>
              )}
            </div>

            <div class="flex items-center gap-3 pt-3 border-t border-slate-200/60 mt-3">
              {item.pdfUrl ? (
                <a
                  href={item.pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 text-xs sm:text-sm font-bold shadow-xs transition"
                >
                  <Icon name="download" class="w-3.5 h-3.5 text-white" />
                  <span>{isNe ? 'PDF डाउनलोड' : 'Download PDF'}</span>
                </a>
              ) : null}
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-blue-700 hover:text-blue-900 transition"
              >
                <span>{isNe ? 'वेबसाइटमा हेर्नुहोस् →' : 'View on DHM →'}</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Pagination Toolbar -->
      <div
        id="press-pagination-bar"
        class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs"
      >
        <span id="press-page-indicator" class="font-bold text-slate-600">
          Showing 1 to 6 of {items.length}
        </span>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="press-prev-btn"
            class="cursor-pointer rounded-xl border border-slate-200 bg-white px-3.5 py-1.5 font-bold text-slate-700 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed shadow-2xs transition"
          >
            ← {isNe ? 'अघिल्लो' : 'Previous'}
          </button>
          <div id="press-page-pills" class="flex items-center gap-1"></div>
          <button
            type="button"
            id="press-next-btn"
            class="cursor-pointer rounded-xl border border-slate-200 bg-white px-3.5 py-1.5 font-bold text-slate-700 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed shadow-2xs transition"
          >
            {isNe ? 'पछिल्लो' : 'Next'} →
          </button>
        </div>
      </div>
    </div>
  ) : (
    <div class="text-center py-8 text-sm font-semibold text-slate-500">
      {isNe ? 'कुनै प्रेस विज्ञप्ति फेला परेन।' : 'No press releases available at this moment.'}
    </div>
  )}
</div>

<script define:vars={{ pageSize }}>
  function initPressPagination() {
    const cards = Array.from(document.querySelectorAll('[data-press-card]'));
    if (!cards.length) return;

    const searchInput = document.getElementById('press-search-input');
    const prevBtn = document.getElementById('press-prev-btn');
    const nextBtn = document.getElementById('press-next-btn');
    const pageIndicator = document.getElementById('press-page-indicator');
    const pillsContainer = document.getElementById('press-page-pills');

    let currentPage = 1;
    let filteredCards = [...cards];

    function renderPage() {
      const totalPages = Math.ceil(filteredCards.length / pageSize) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // Hide all first
      cards.forEach((c) => (c.style.display = 'none'));

      // Show slice of filtered cards
      const startIdx = (currentPage - 1) * pageSize;
      const endIdx = startIdx + pageSize;
      filteredCards.slice(startIdx, endIdx).forEach((c) => (c.style.display = 'flex'));

      // Update indicator
      if (pageIndicator) {
        const displayStart = filteredCards.length ? startIdx + 1 : 0;
        const displayEnd = Math.min(endIdx, filteredCards.length);
        pageIndicator.textContent = `Showing ${displayStart} - ${displayEnd} of ${filteredCards.length} releases`;
      }

      // Update Prev / Next buttons
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

      // Render numeric page buttons if totalPages > 1
      if (pillsContainer) {
        pillsContainer.innerHTML = '';
        if (totalPages > 1) {
          for (let p = 1; p <= totalPages; p++) {
            if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.textContent = String(p);
              btn.className = `cursor-pointer rounded-lg px-2.5 py-1 text-xs font-bold transition shadow-2xs ${
                p === currentPage
                  ? 'bg-blue-600 text-white font-black'
                  : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'
              }`;
              btn.onclick = () => {
                currentPage = p;
                renderPage();
              };
              pillsContainer.appendChild(btn);
            } else if (
              (p === 2 && currentPage > 3) ||
              (p === totalPages - 1 && currentPage < totalPages - 2)
            ) {
              const dots = document.createElement('span');
              dots.textContent = '...';
              dots.className = 'text-slate-400 px-1 text-xs';
              pillsContainer.appendChild(dots);
            }
          }
        }
      }
    }

    if (prevBtn) {
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
        }
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        const totalPages = Math.ceil(filteredCards.length / pageSize) || 1;
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
        }
      };
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        if (!q) {
          filteredCards = [...cards];
        } else {
          filteredCards = cards.filter((c) => {
            const t = c.getAttribute('data-title') || '';
            const s = c.getAttribute('data-subtitle') || '';
            return t.includes(q) || s.includes(q);
          });
        }
        currentPage = 1;
        renderPage();
      });
    }

    renderPage();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPressPagination);
  } else {
    initPressPagination();
  }
</script>
