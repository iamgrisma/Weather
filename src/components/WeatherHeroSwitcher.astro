---
import type { CityForecastStation } from '../lib/dhm/types';
import Icon from './Icon.astro';
import { getProxiedImageUrl } from '../lib/utils/image';

interface Props {
  stations: CityForecastStation[];
  lang?: 'en' | 'ne';
}

const { stations = [], lang = 'en' } = Astro.props;
const isNe = lang === 'ne';

// Curate prominent hub cities for rapid switcher buttons
const FEATURED_CITIES = ['Kathmandu', 'Pokhara', 'Biratnagar', 'Nepalgunj', 'Birgunj', 'Dhangadhi', 'Janakpur', 'Surkhet'];

// Sort stations so featured are easy to find
const featuredStations = stations.filter((s) => FEATURED_CITIES.includes(s.name));
const initialStation = stations.find((s) => s.name === 'Kathmandu') || stations[0] || null;

function cleanTime(t?: string): string {
  if (!t) return '--';
  return t.replace(/:\d{2}\s/, ' ');
}
---

<div class="rounded-3xl border border-slate-200/80 bg-linear-to-b from-white to-slate-50/80 p-5 sm:p-7 shadow-sm mb-8" id="weather-hero-widget">
  <!-- Widget Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-100 gap-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-blue-600 animate-pulse"></span>
        <span class="text-xs font-black uppercase tracking-wider text-blue-700">
          {isNe ? 'सहर मौसम पूर्वावलोकन' : 'Live City Forecast Hub'}
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mt-0.5">
        {isNe ? 'प्रमुख सहरहरूको प्रत्यक्ष मौसम' : 'Instant City Weather Glance'}
      </h2>
    </div>

    <!-- Dropdown for All 19 Cities -->
    <div class="flex items-center gap-2">
      <label for="hero-city-select" class="text-xs font-bold text-slate-500 shrink-0">
        {isNe ? 'अन्य सहर:' : 'Select City:'}
      </label>
      <select
        id="hero-city-select"
        class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs sm:text-sm font-bold text-slate-800 shadow-2xs focus:border-blue-500 focus:outline-hidden"
      >
        {stations.map((st) => (
          <option value={st.id} selected={initialStation && st.id === initialStation.id}>
            {st.name} ({st.nepaliName})
          </option>
        ))}
      </select>
    </div>
  </div>

  <!-- Featured City Chips -->
  <div class="flex flex-wrap items-center gap-1.5 pt-3 pb-5">
    {featuredStations.map((st) => (
      <button
        type="button"
        data-city-id={st.id}
        class={`hero-city-chip cursor-pointer rounded-xl px-3 py-1.5 text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5 ${
          initialStation && st.id === initialStation.id
            ? 'bg-blue-600 text-white shadow-xs font-black'
            : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'
        }`}
      >
        <Icon name="map-pin" class="w-3.5 h-3.5 shrink-0" />
        <span>{isNe ? st.nepaliName : st.name}</span>
      </button>
    ))}
  </div>

  <!-- Active City Cards Container -->
  {stations.map((st) => {
    const isDefault = initialStation && st.id === initialStation.id;
    const firstF = st.forecasts?.[0];
    const laterForecasts = st.forecasts?.slice(1) || [];

    return (
      <div
        id={`hero-card-${st.id}`}
        class={`hero-city-card ${isDefault ? 'block' : 'hidden'}`}
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
          <!-- Primary Main Hero Column -->
          <div class="lg:col-span-7 rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-slate-900 p-6 sm:p-8 text-white shadow-md relative overflow-hidden flex flex-col justify-between">
            <!-- Background Atmospheric Glow -->
            <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>

            <div>
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-mono font-bold text-blue-200 uppercase tracking-widest block">
                    {isNe ? 'नेपाल जल तथा मौसम विज्ञान विभाग' : 'Department of Hydrology & Meteorology'}
                  </span>
                  <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-white mt-1">
                    {isNe ? st.nepaliName : st.name}
                  </h3>
                  <span class="text-xs text-blue-100 font-medium">
                    {isNe ? `${st.name} • अक्षांश ${st.latitude.toFixed(2)}°, देशान्तर ${st.longitude.toFixed(2)}°` : `${st.nepaliName} • Lat ${st.latitude.toFixed(2)}°, Lon ${st.longitude.toFixed(2)}°`}
                  </span>
                </div>

                {firstF?.dayIcon && (
                  <div class="h-16 w-16 sm:h-20 sm:w-20 rounded-2xl bg-white/15 p-2 backdrop-blur-xs shrink-0 flex items-center justify-center">
                    <img
                      src={getProxiedImageUrl(firstF.dayIcon)}
                      onerror={`this.onerror=null;this.src='${firstF.dayIcon}'`}
                      alt={firstF.weatherName}
                      class="h-full w-full object-contain filter drop-shadow"
                    />
                  </div>
                )}
              </div>

              <!-- Main Temperature & Condition -->
              <div class="mt-6 flex flex-wrap items-baseline gap-3">
                <span class="text-3xl sm:text-4xl font-black font-mono tracking-tight text-white whitespace-nowrap">
                  {firstF?.fromTemp ?? '--'}° – {firstF?.toTemp ?? '--'}°C
                </span>
                <span class="rounded-lg bg-white/20 px-2.5 py-1 text-xs font-bold text-blue-100 backdrop-blur-xs">
                  {firstF ? (isNe ? firstF.weatherNepali : firstF.weatherName) : (isNe ? 'विवरण उपलब्ध छैन' : 'Data Pending')}
                </span>
              </div>
            </div>

            <!-- Weather Details Grid -->
            <div class="mt-6 pt-5 border-t border-white/15 grid grid-cols-3 gap-2 text-center text-xs">
              <div class="bg-white/10 rounded-xl p-2.5 backdrop-blur-xs">
                <span class="text-blue-200 block text-[11px] font-semibold">{isNe ? 'वर्षा सम्भावना' : 'Rain Prob'}</span>
                <span class="font-mono font-black text-white text-sm mt-0.5 block">{firstF?.rainProbability ?? 0}%</span>
              </div>
              <div class="bg-white/10 rounded-xl p-2.5 backdrop-blur-xs">
                <span class="text-blue-200 block text-[11px] font-semibold flex items-center justify-center gap-1">
                  <Icon name="sun" class="w-3 h-3 text-amber-300" />
                  <span>{isNe ? 'सूर्योदय' : 'Sunrise'}</span>
                </span>
                <span class="font-mono font-bold text-white text-xs mt-0.5 block">{cleanTime(st.sunrise)}</span>
              </div>
              <div class="bg-white/10 rounded-xl p-2.5 backdrop-blur-xs">
                <span class="text-blue-200 block text-[11px] font-semibold flex items-center justify-center gap-1">
                  <Icon name="moon" class="w-3 h-3 text-indigo-200" />
                  <span>{isNe ? 'सूर्यास्त' : 'Sunset'}</span>
                </span>
                <span class="font-mono font-bold text-white text-xs mt-0.5 block">{cleanTime(st.sunset)}</span>
              </div>
            </div>
          </div>

          <!-- Upcoming Days Outlook Column -->
          <div class="lg:col-span-5 flex flex-col justify-between gap-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-2xs flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                  <span class="text-xs font-black uppercase tracking-wider text-slate-500">
                    {isNe ? 'आगामी दिनहरूको पूर्वानुमान' : 'Upcoming Horizon'}
                  </span>
                  <span class="text-[11px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md">
                    {st.forecasts.length} {isNe ? 'दिन' : 'Days'}
                  </span>
                </div>

                <div class="divide-y divide-slate-100 mt-2">
                  {st.forecasts.map((f, fIdx) => (
                    <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-3">
                      <div class="flex items-center gap-2.5 min-w-0">
                        {f.dayIcon ? (
                          <img
                            src={getProxiedImageUrl(f.dayIcon)}
                            onerror={`this.onerror=null;this.src='${f.dayIcon}'`}
                            alt={f.weatherName}
                            class="h-8 w-8 object-contain shrink-0"
                          />
                        ) : (
                          <Icon name="cloud" class="w-6 h-6 text-slate-400 shrink-0" />
                        )}
                        <div class="min-w-0">
                          <span class="text-xs font-black text-slate-800 block">
                            {isNe ? `दिन ${f.day}` : `Day ${f.day}`} {fIdx === 0 ? (isNe ? '(आज)' : '(Today)') : ''}
                          </span>
                          <span class="text-[11px] text-slate-500 font-medium truncate block">
                            {isNe ? f.weatherNepali : f.weatherName}
                          </span>
                        </div>
                      </div>

                      <div class="text-right shrink-0">
                        <span class="font-mono text-xs sm:text-sm font-black text-slate-900 whitespace-nowrap block">
                          {f.fromTemp ?? '--'}° – {f.toTemp ?? '--'}°C
                        </span>
                        <span class="text-[10px] text-blue-600 font-semibold flex items-center justify-end gap-0.5">
                          <Icon name="droplet" class="w-2.5 h-2.5 text-blue-500" />
                          <span>{f.rainProbability}%</span>
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="pt-3 border-t border-slate-100 mt-3">
                <a
                  href="/city-forecast"
                  class="flex items-center justify-center gap-1.5 w-full rounded-xl bg-slate-100 hover:bg-blue-50 hover:text-blue-700 text-slate-700 font-bold text-xs py-2 transition"
                >
                  <span>{isNe ? 'सबै १९ सहरको ३-दिने तालिका हेर्नुहोस् →' : 'Explore all 19 cities in Weather Hub →'}</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  })}
</div>

<script>
  function setupWeatherHero() {
    const chips = document.querySelectorAll('.hero-city-chip');
    const select = document.getElementById('hero-city-select') as HTMLSelectElement | null;
    const cards = document.querySelectorAll('.hero-city-card');

    function showCity(id: string) {
      cards.forEach((c) => {
        if (c.id === `hero-card-${id}`) {
          c.classList.remove('hidden');
          c.classList.add('block');
        } else {
          c.classList.add('hidden');
          c.classList.remove('block');
        }
      });

      chips.forEach((btn) => {
        if (btn.getAttribute('data-city-id') === id) {
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-xs', 'font-black');
          btn.classList.remove('bg-white', 'border', 'border-slate-200', 'text-slate-700');
        } else {
          btn.classList.remove('bg-blue-600', 'text-white', 'shadow-xs', 'font-black');
          btn.classList.add('bg-white', 'border', 'border-slate-200', 'text-slate-700');
        }
      });

      if (select && select.value !== id) {
        select.value = id;
      }
    }

    chips.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-city-id');
        if (id) showCity(id);
      });
    });

    if (select) {
      select.addEventListener('change', (e: any) => {
        showCity(e.target.value);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWeatherHero);
  } else {
    setupWeatherHero();
  }
</script>
