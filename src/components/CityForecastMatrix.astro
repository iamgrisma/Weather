---
import type { CityForecastStation } from '../lib/dhm/types';
import { getProxiedImageUrl } from '../lib/utils/image';
import Icon from './Icon.astro';

interface Props {
  stations: CityForecastStation[];
  lang?: 'en' | 'ne';
}

const { stations, lang = 'en' } = Astro.props;
const isNe = lang === 'ne';

function formatTime(timeStr?: string): string {
  if (!timeStr) return '';
  return timeStr.replace(/(:\d{2}):\d{2}(\s*[A-Z]*)/i, '$1$2').trim();
}
---

<div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-8 shadow-sm mb-8" id="city-forecast-matrix-card">
  <!-- Header & Controls -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-100 pb-5 mb-6">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="inline-flex h-3 w-3 rounded-full bg-emerald-600 animate-pulse"></span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
          {isNe ? 'प्रमुख सहरहरूको ३ दिने मौसम पूर्वानुमान' : 'Major Cities 3-Day Weather Forecast'}
        </h2>
      </div>
      <p class="text-xs sm:text-sm font-semibold text-slate-500 mt-1">
        {isNe
          ? `नेपालका १९ मुख्य सहरहरूको न्यूनतम/अधिकतम तापक्रम, वर्षा सम्भावना र मौसम अवस्था`
          : `Official multi-day forecast across 19 administrative and regional centers in Nepal.`}
      </p>
    </div>

    <!-- Search input -->
    <div class="w-full sm:w-72">
      <input
        type="search"
        id="city-search-input"
        placeholder={isNe ? 'सहर खोज्नुहोस्...' : 'Search city (e.g. Pokhara, Nepalgunj)...'}
        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-800 placeholder-slate-400 focus:border-blue-500 focus:bg-white focus:outline-none shadow-2xs"
      />
    </div>
  </div>

  <!-- City Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="city-cards-container">
    {stations.map((st) => (
      <div
        class="rounded-2xl border border-slate-200/90 bg-slate-50/70 p-4 sm:p-5 hover:border-blue-300 hover:shadow-sm transition-all city-card flex flex-col justify-between"
        data-name={`${st.name} ${st.nepaliName}`.toLowerCase()}
      >
        <!-- City Header Bar -->
        <div class="flex items-start justify-between mb-3.5 border-b border-slate-200/70 pb-3 gap-2">
          <div>
            <div class="flex items-center gap-1.5">
              <Icon name="map-pin" class="w-4 h-4 text-blue-600 shrink-0" />
              <h3 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
                {isNe ? st.nepaliName : st.name}
              </h3>
            </div>
            <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200/60 px-2 py-0.5 rounded-md inline-block mt-1">
              {isNe ? st.name : st.nepaliName}
            </span>
          </div>

          {(st.sunrise || st.sunset) && (
            <div class="text-[11px] sm:text-xs text-slate-600 font-semibold bg-white border border-slate-200/80 px-2.5 py-1 rounded-xl shadow-2xs shrink-0 text-right leading-tight">
              {st.sunrise && <div class="flex items-center gap-1 justify-end"><Icon name="sunrise" class="w-3 h-3 text-amber-500 shrink-0" /> {formatTime(st.sunrise)}</div>}
              {st.sunset && <div class="mt-0.5 flex items-center gap-1 justify-end"><Icon name="sunset" class="w-3 h-3 text-indigo-500 shrink-0" /> {formatTime(st.sunset)}</div>}
            </div>
          )}
        </div>

        <!-- Forecast Days (Clean Horizontal Rows) -->
        <div class="space-y-2.5">
          {st.forecasts.slice(0, 3).map((f) => {
            const dayLabel = f.day === 1 ? (isNe ? 'आज' : 'Today') : f.day === 2 ? (isNe ? 'भोलि' : 'Tomorrow') : (isNe ? 'पर्सि' : 'Day 3');
            return (
              <div class="flex items-center justify-between rounded-xl bg-white border border-slate-200/90 p-3 hover:border-blue-400 hover:shadow-xs transition-all shadow-2xs gap-2.5">
                <!-- Left: Day badge, Icon, Condition -->
                <div class="flex items-center gap-3 min-w-0">
                  {f.dayIcon ? (
                    <div class="h-10 w-10 shrink-0 flex items-center justify-center rounded-lg bg-slate-50 border border-slate-100 p-0.5">
                      <img
                        src={getProxiedImageUrl(f.dayIcon)}
                        onerror={`this.onerror=null;this.src='${f.dayIcon}'`}
                        alt={f.weatherName}
                        class="h-8 w-8 object-contain"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div class="h-10 w-10 shrink-0 flex items-center justify-center rounded-lg bg-slate-50 border border-slate-100">
                      <Icon name="cloud-sun" class="w-6 h-6 text-slate-500" />
                    </div>
                  )}

                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class={`rounded-md px-2 py-0.5 text-[11px] font-black uppercase tracking-wider ${f.day === 1 ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700'}`}>
                        {dayLabel}
                      </span>
                      {f.rainProbability > 0 && (
                        <span class="rounded-full bg-blue-50 border border-blue-200 text-blue-700 px-2 py-0.5 text-[11px] font-bold flex items-center gap-1">
                          <Icon name="droplet" class="w-3 h-3 text-blue-500 shrink-0" /> {f.rainProbability}%
                        </span>
                      )}
                    </div>
                    <span class="text-xs sm:text-sm font-bold text-slate-800 truncate block mt-1" title={f.weatherName}>
                      {isNe ? f.weatherNepali : f.weatherName}
                    </span>
                  </div>
                </div>

                <!-- Right: Temperature Range -->
                <div class="text-right shrink-0 pl-2">
                  <span class="text-sm sm:text-base font-mono font-black text-slate-900 whitespace-nowrap block">
                    {f.fromTemp !== null && f.toTemp !== null ? (
                      <span>{f.fromTemp}° – {f.toTemp}°C</span>
                    ) : f.toTemp !== null ? (
                      <span>{f.toTemp}°C</span>
                    ) : (
                      <span class="text-slate-400">-</span>
                    )}
                  </span>
                  <span class="text-[10px] font-semibold text-slate-400 block uppercase">
                    {f.fromTemp !== null ? 'Min / Max' : 'Temp'}
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  const searchInput = document.getElementById('city-search-input');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = (e.target.value || '').trim().toLowerCase();
      const cards = document.querySelectorAll('.city-card');
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        if (!q || name.includes(q)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>
