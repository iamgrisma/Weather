---
import type { RefreshScope } from '../lib/dhm/types';

interface Props {
  fetchedAt: number;
  lastCheckedAt?: number;
  scope?: RefreshScope;
  lang?: 'en' | 'ne';
}

const { fetchedAt, lastCheckedAt, scope = 'river', lang = 'en' } = Astro.props;
const isNe = lang === 'ne';

const buttonLabels: Record<RefreshScope, { en: string; ne: string }> = {
  river: { en: 'Fetch Fresh River Levels', ne: 'नदी जलसतह ताजा पार्नुहोस्' },
  weather: { en: 'Fetch Fresh Weather', ne: 'मौसम विवरण ताजा पार्नुहोस्' },
  tourism: { en: 'Refresh Tourism Stations', ne: 'पर्यटकीय मौसम ताजा पार्नुहोस्' },
  bulletin: { en: 'Fetch Fresh Synoptic Bulletin', ne: 'मौसम बुलेटिन ताजा पार्नुहोस्' },
  mountain: { en: 'Refresh Mountain Weather', ne: 'पर्वतीय मौसम ताजा पार्नुहोस्' },
  cities: { en: 'Refresh City Forecasts', ne: 'सहरहरूको पूर्वानुमान ताजा पार्नुहोस्' },
  special: { en: 'Refresh Special Weather Warnings', ne: 'विशेष मौसमी चेतावनी ताजा पार्नुहोस्' },
  press: { en: 'Refresh Press Releases', ne: 'प्रेस विज्ञप्ति ताजा पार्नुहोस्' },
  nwp: { en: 'Refresh NWP Models', ne: 'NWP मोडेल ताजा पार्नुहोस्' },
  all: { en: 'Fetch All Fresh Feeds', ne: 'सबै ताजा डाटा खोज्नुहोस्' },
};

const activeLabel = buttonLabels[scope] || buttonLabels.river;
---

<div
  class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm"
  id="refresh-widget"
  data-fetched-at={fetchedAt}
  data-scope={scope}
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3.5">
      <div class="relative flex h-3.5 w-3.5 shrink-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-3.5 w-3.5 rounded-full bg-emerald-500"></span>
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-700">
            {isNe ? 'प्रत्यक्ष डाटा स्थिति' : `${scope.toUpperCase()} Live Status`}
          </span>
          <span class="rounded-lg bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-xs sm:text-sm font-bold text-emerald-800" id="time-ago-badge">
            Calculating...
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5 font-normal" id="last-sync-time">
          {isNe ? 'सरकारी सर्भरसँग स्वचालित समक्रमण • १०-मिनेट कुलडाउन सुरक्षा' : 'Direct edge cache from DHM / MFD • 10-Minute Upstream Shield'}
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="manual-refresh-btn"
        class="inline-flex cursor-pointer items-center justify-center gap-2.5 rounded-xl bg-blue-600 px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-md shadow-blue-500/20 transition-all hover:bg-blue-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50"
      >
        <svg class="h-4 w-4" id="refresh-spinner" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span id="btn-text">{isNe ? activeLabel.ne : activeLabel.en}</span>
      </button>
    </div>
  </div>

  <div id="refresh-toast" class="mt-3.5 hidden rounded-xl border p-3 text-xs sm:text-sm font-semibold transition-all"></div>
</div>

<script>
  function setupRefreshWidget() {
    const container = document.getElementById('refresh-widget');
    if (!container) return;

    const fetchedAt = Number(container.getAttribute('data-fetched-at')) || Date.now();
    const scope = container.getAttribute('data-scope') || 'river';
    const badge = document.getElementById('time-ago-badge');
    const refreshBtn = document.getElementById('manual-refresh-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const spinner = document.getElementById('refresh-spinner');
    const toast = document.getElementById('refresh-toast');
    const defaultBtnLabel = btnText?.textContent || 'Fetch Fresh Data';

    function updateTimeAgo() {
      const now = Date.now();
      const elapsedMs = Math.max(0, now - fetchedAt);
      const minutes = Math.floor(elapsedMs / 60000);
      const seconds = Math.floor((elapsedMs % 60000) / 1000);

      if (badge) {
        if (minutes === 0) {
          badge.textContent = `Live (${seconds}s ago)`;
        } else if (minutes === 1) {
          badge.textContent = `Updated 1 min ago`;
        } else {
          badge.textContent = `Updated ${minutes} mins ago`;
        }
      }
    }

    updateTimeAgo();
    setInterval(updateTimeAgo, 5000);

    if (refreshBtn) {
      refreshBtn.addEventListener('click', async () => {
        refreshBtn.disabled = true;
        if (spinner) spinner.classList.add('animate-spin');
        if (btnText) btnText.textContent = 'Contacting DHM Gateway...';

        try {
          const res = await fetch(`/api/refresh?scope=${encodeURIComponent(scope)}`, {
            method: 'POST',
          });
          const json = await res.json();

          if (toast) {
            toast.classList.remove('hidden', 'bg-amber-50', 'border-amber-200', 'text-amber-800', 'bg-emerald-50', 'border-emerald-200', 'text-emerald-800', 'bg-blue-50', 'border-blue-200', 'text-blue-800');
            
            if (json.status === 'throttled') {
              toast.classList.add('bg-amber-50', 'border-amber-200', 'text-amber-800');
              toast.textContent = json.message || 'Cooldown window active. Please wait.';
            } else if (json.status === 'unchanged') {
              toast.classList.add('bg-blue-50', 'border-blue-200', 'text-blue-800');
              toast.textContent = json.message || 'Upstream data has not changed yet.';
            } else if (json.status === 'updated') {
              toast.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-800');
              toast.textContent = `Fresh live ${scope} data loaded! Reloading view...`;
              setTimeout(() => window.location.reload(), 800);
            } else {
              toast.classList.add('bg-amber-50', 'border-amber-200', 'text-amber-800');
              toast.textContent = json.message || 'Response received.';
            }
          }
        } catch (err: any) {
          if (toast) {
            toast.classList.remove('hidden');
            toast.classList.add('bg-red-50', 'border-red-200', 'text-red-800');
            toast.textContent = 'Network error while contacting DHM servers.';
          }
        } finally {
          refreshBtn.disabled = false;
          if (spinner) spinner.classList.remove('animate-spin');
          if (btnText) btnText.textContent = defaultBtnLabel;
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRefreshWidget);
  } else {
    setupRefreshWidget();
  }
</script>
