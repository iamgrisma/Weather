---
import type { TrekkingRoute } from '../lib/dhm/types';
import Icon from './Icon.astro';

interface Props {
  routes: TrekkingRoute[];
  lang?: 'en' | 'ne';
}

const { routes, lang = 'en' } = Astro.props;
const isNe = lang === 'ne';
---

{routes && routes.length > 0 && (
  <section class="mb-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" id="trekking-corridors">
    <header class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
      <div>
        <h3 class="text-base font-black text-slate-900 tracking-tight flex items-center gap-2">
          <Icon name="mountain" class="w-4 h-4 text-indigo-600 shrink-0" />
          {isNe ? 'प्रमुख पदमार्ग तथा हिमाली करिडोर' : 'Major Trekking Corridors & Mountain Passes'}
        </h3>
        <p class="text-xs text-slate-500">
          {isNe ? 'पर्यटन तथा हिमाली मौसम अनुगमन सञ्जाल' : 'DHM Tourism Weather monitoring network for expedition routes'}
        </p>
      </div>
      <span class="rounded bg-indigo-50 px-2 py-0.5 text-xs font-bold text-indigo-700">
        {routes.length} {isNe ? 'पदमार्गहरू' : 'Routes'}
      </span>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      {routes.map((r) => (
        <article class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/50 hover:border-indigo-300 hover:bg-indigo-50/30 transition-all">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-slate-900">{r.name}</h4>
            <span class="text-[10px] font-mono font-bold text-indigo-700 bg-indigo-100/60 px-1.5 py-0.5 rounded">
              {r.distanceKm > 0 ? `${r.distanceKm} km` : 'Trail'}
            </span>
          </div>
          <p class="text-[10px] text-slate-400 mt-1">
            Start: {r.startPoint[0].toFixed(2)}°N, {r.startPoint[1].toFixed(2)}°E
          </p>
        </article>
      ))}
    </div>
  </section>
)}
