---
import type { CountryForecast } from '../lib/dhm/types';
import Icon from './Icon.astro';

interface Props {
  forecast: CountryForecast | null;
  lang?: 'en' | 'ne';
}

const { forecast, lang = 'en' } = Astro.props;
const isNe = lang === 'ne';
---

{forecast ? (
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-5 py-4 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between bg-slate-50/50">
      <div>
        <h3 class="text-base font-bold text-slate-900">
          {isNe ? 'देशभरको २४ घण्टे मौसमी पूर्वानुमान (24-Hour National Weather Forecast)' : '24-Hour Nationwide Weather Forecast'}
        </h3>
        <p class="text-xs text-slate-500">
          {isNe ? 'मौसम पूर्वानुमान महाशाखा (MFD), जल तथा मौसम विज्ञान विभाग' : 'Meteorological Forecasting Division (MFD)'} • {new Date(forecast.issueDate).toLocaleDateString()}
        </p>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-800">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        {isNe ? 'दैनिक बुलेटिन' : 'Daily Bulletin'}
      </span>
    </div>

    <div class="p-5 space-y-4 text-xs leading-relaxed text-slate-700">
      {forecast.synopsisNp && (
        <div class="rounded-xl border border-blue-100 bg-blue-50/50 p-4">
          <h4 class="font-bold text-blue-900 mb-1 flex items-center gap-2">
            <Icon name="info" class="w-4 h-4 text-blue-700 shrink-0" /> {isNe ? 'मौसम विश्लेषण (Synoptic Weather Analysis)' : 'Synoptic Meteorological Analysis'}
          </h4>
          <p class="text-slate-800 whitespace-pre-line">
            {forecast.synopsisNp}
          </p>
        </div>
      )}

      {forecast.specialWarningNp && (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
          <h4 class="font-bold text-amber-900 mb-1 flex items-center gap-2">
            <Icon name="alert-triangle" class="w-4 h-4 text-amber-600 shrink-0" /> {isNe ? 'विशेष सतर्कता तथा चेतावनी' : 'Special Weather Warning'}
          </h4>
          <p class="text-amber-950">
            {forecast.specialWarningNp}
          </p>
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <h4 class="font-bold text-slate-900 mb-2 flex items-center gap-1.5">
            <Icon name="sun" class="w-4 h-4 text-amber-500 shrink-0" /> {isNe ? 'दिउँसोको मौसम (Daytime Forecast)' : 'Daytime Weather Outlook'}
          </h4>
          <p class="text-slate-700 leading-normal">
            {isNe ? forecast.forecastDayNp : (forecast.forecastDayEn || forecast.forecastDayNp)}
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <h4 class="font-bold text-slate-900 mb-2 flex items-center gap-1.5">
            <Icon name="moon" class="w-4 h-4 text-indigo-500 shrink-0" /> {isNe ? 'रातिको मौसम (Nighttime Forecast)' : 'Nighttime Weather Outlook'}
          </h4>
          <p class="text-slate-700 leading-normal">
            {isNe ? forecast.forecastNightNp : (forecast.forecastNightEn || forecast.forecastNightNp)}
          </p>
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center text-xs text-slate-500">
    {isNe ? 'हाल मौसमी बुलेटिन उपलब्ध छैन।' : 'No active forecast bulletin currently published.'}
  </div>
)}
