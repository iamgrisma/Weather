---
import type { SpecialWeatherAdvisory, EmergencyNotice } from '../lib/dhm/types';
import Icon from './Icon.astro';
import { getProxiedImageUrl } from '../lib/utils/image';

interface Props {
  items: SpecialWeatherAdvisory[];
  activeNotice?: EmergencyNotice | null;
  lang?: 'en' | 'ne';
}

const { items = [], activeNotice, lang = 'en' } = Astro.props;
const isNe = lang === 'ne';
const latest = items[0] || null;

function rewriteContentImages(html?: string | null): string {
  if (!html) return '';
  let normalized = html.replace(/(src|href)=["']\/(?:mfd\/api\/image\/|uploads\/)([^"']+)["']/gi, (_m, attr, path) => {
    return `${attr}="https://dhm.gov.np/mfd/api/image/${path}"`;
  });
  return normalized.replace(
    /(src|href)=["'](https?:\/\/(?:dhm\.gov\.np|hydrology\.gov\.np)[^"']+)["']/gi,
    (_match, attr, url) => `${attr}="${getProxiedImageUrl(url)}"`
  );
}
---

<div class="space-y-6 mb-8" id="special-weather-section">
  <!-- Active Emergency Popup Notice if present -->
  {activeNotice && (
    <div class="rounded-2xl border-2 border-red-500 bg-red-50 p-5 sm:p-6 shadow-sm">
      <div class="flex items-start gap-3">
        <Icon name="alert-circle" class="w-6 h-6 text-red-600 shrink-0 mt-0.5" />
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="rounded-md bg-red-600 px-2.5 py-1 text-xs font-black uppercase tracking-wider text-white">
              {isNe ? 'आपतकालीन सूचना' : 'Urgent Notice'}
            </span>
            {activeNotice.createdAt && (
              <span class="text-xs text-red-700 font-semibold">
                {new Date(activeNotice.createdAt).toLocaleDateString(isNe ? 'ne-NP' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            )}
          </div>
          <h3 class="text-base sm:text-lg font-black text-red-950">
            {isNe ? (activeNotice.nepaliTitle || activeNotice.title) : (activeNotice.title || activeNotice.nepaliTitle)}
          </h3>
          {activeNotice.url && (
            <div class="mt-3">
              {activeNotice.url.match(/\.(jpe?g|png|webp)$/i) && (
                <div class="mb-3 max-w-xl overflow-hidden rounded-xl border border-red-200 bg-white shadow-2xs">
                  <img
                    src={getProxiedImageUrl(activeNotice.url.startsWith('http') ? activeNotice.url : `https://dhm.gov.np/mfd/api/image/${activeNotice.url.replace(/^\/+/, '')}`)}
                    onerror={`this.onerror=null;this.src='${activeNotice.url.startsWith('http') ? activeNotice.url : 'https://dhm.gov.np/mfd/api/image/' + activeNotice.url.replace(/^\/+/, '')}'`}
                    alt={activeNotice.title}
                    loading="lazy"
                    class="w-full h-auto max-h-[420px] object-contain"
                  />
                </div>
              )}
              <a
                href={getProxiedImageUrl(activeNotice.url.startsWith('http') ? activeNotice.url : `https://dhm.gov.np/mfd/api/image/${activeNotice.url.replace(/^\/+/, '')}`)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-red-700 hover:text-red-900 underline"
              >
                <span>{isNe ? 'आधिकारिक बुलेटिन पूर्ण आकारमा हेर्नुहोस् ↗' : 'View official bulletin full size ↗'}</span>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  <!-- Primary Featured Special Weather Advisory -->
  {latest ? (
    <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-amber-100 pb-5 mb-6 gap-3">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-3 w-3 rounded-full bg-amber-500 animate-pulse"></span>
            <span class="rounded-md bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-1 text-xs font-black uppercase">
              {isNe ? 'विशेष मौसमी चेतावनी' : 'Special Weather Warning'}
            </span>
          </div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mt-2">
            {latest.title}
          </h2>
        </div>

        <div class="flex items-center gap-2">
          <span class="rounded-xl bg-amber-50 border border-amber-200 px-3.5 py-1.5 text-xs sm:text-sm font-bold text-amber-900">
            {isNe ? 'जारी मिति:' : 'Issued:'} {new Date(latest.createdAt).toLocaleDateString(isNe ? 'ne-NP' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
          </span>
        </div>
      </div>

      <!-- Warning Map Images -->
      {latest.weatherMapImages && latest.weatherMapImages.length > 0 && (
        <div class="mb-6">
          <h3 class="text-sm sm:text-base font-black uppercase tracking-wider text-slate-800 mb-3 flex items-center gap-2">
            <Icon name="layers" class="w-4 h-4 text-amber-600" />
            <span>{isNe ? 'चेतावनी नक्साहरू (Warning Maps)' : 'Official Hazard & Warning Maps'}</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {latest.weatherMapImages.map((img, idx) => (
              <a
                href={getProxiedImageUrl(img.url)}
                target="_blank"
                rel="noopener noreferrer"
                class="group block overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 hover:border-amber-500 hover:shadow-md transition"
              >
                <div class="aspect-4/3 overflow-hidden bg-white relative">
                  <img
                    src={getProxiedImageUrl(img.url)}
                    onerror={`this.onerror=null;this.src='${img.url}'`}
                    alt={`Warning Map ${idx + 1}`}
                    loading="lazy"
                    class="h-full w-full object-contain group-hover:scale-105 transition-transform duration-200"
                  />
                </div>
                <div class="p-3 bg-white border-t border-slate-100 text-center">
                  <span class="text-xs sm:text-sm font-bold text-slate-800 block">
                    {isNe ? `दिन ${idx + 1} चेतावनी नक्सा` : `Day ${idx + 1} Warning Map`}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Description or HTML Content -->
      {latest.content ? (
        <div
          class="prose prose-sm sm:prose-base max-w-none text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 border-t border-slate-100 pt-5"
          set:html={rewriteContentImages(latest.content)}
        />
      ) : latest.description ? (
        <p class="text-sm sm:text-base text-slate-700 leading-relaxed border-t border-slate-100 pt-5">
          {latest.description}
        </p>
      ) : (
        <p class="text-sm text-slate-500 italic border-t border-slate-100 pt-4">
          {isNe ? 'यस बुलेटिनमा विस्तृत पाठ्य विवरण उपलब्ध छैन, माथिका नक्साहरू हेर्नुहोस्।' : 'No additional text description attached, consult warning maps above.'}
        </p>
      )}
    </div>
  ) : (
    <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center text-sm font-semibold text-slate-500">
      {isNe ? 'हाल कुनै विशेष मौसमी चेतावनी सक्रिय छैन।' : 'No active special weather warning currently published.'}
    </div>
  )}

  <!-- Recent Previous Bulletins Archive -->
  {items.length > 1 && (
    <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <h3 class="text-base sm:text-lg font-black text-slate-900 flex items-center gap-2">
          <Icon name="document" class="w-4 h-4 text-slate-500" />
          <span>{isNe ? 'अघिल्ला मौसमी चेतावनी तथा सूचनाहरू' : 'Recent Weather Warnings Archive'}</span>
        </h3>
        <span class="text-xs font-bold text-slate-400">
          {items.length - 1} {isNe ? 'सूचनाहरू' : 'records'}
        </span>
      </div>

      <div class="space-y-3">
        {items.slice(1).map((item) => (
          <details class="group rounded-xl border border-slate-200 bg-slate-50/40 hover:bg-slate-50 transition-colors duration-150 overflow-hidden">
            <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer list-none select-none">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class="text-xs font-semibold text-slate-400">
                    {new Date(item.createdAt).toLocaleDateString(isNe ? 'ne-NP' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                  {item.weatherMapImages && item.weatherMapImages.length > 0 && (
                    <span class="inline-flex items-center gap-1 rounded bg-amber-100 text-amber-800 text-[10px] font-bold px-1.5 py-0.5">
                      <Icon name="layers" class="w-3 h-3" />
                      <span>{item.weatherMapImages.length} {isNe ? 'नक्सा' : 'Maps'}</span>
                    </span>
                  )}
                  {item.content && (
                    <span class="inline-flex items-center rounded bg-blue-50 text-blue-700 text-[10px] font-bold px-1.5 py-0.5">
                      {isNe ? 'पूर्ण पाठ' : 'Full Bulletin'}
                    </span>
                  )}
                </div>
                <h4 class="text-sm sm:text-base font-bold text-slate-900 group-open:text-blue-600 transition-colors">
                  {item.title}
                </h4>
                {item.description && !item.content && (
                  <p class="text-xs text-slate-500 mt-1 line-clamp-1 group-open:hidden">
                    {item.description}
                  </p>
                )}
              </div>
              <div class="shrink-0 text-slate-400 group-hover:text-slate-600 group-open:rotate-180 transition-transform duration-200">
                <Icon name="chevron-down" class="w-4 h-4" />
              </div>
            </summary>

            <div class="border-t border-slate-200 bg-white p-4 sm:p-6 space-y-4">
              {item.weatherMapImages && item.weatherMapImages.length > 0 && (
                <div>
                  <h5 class="text-xs font-black uppercase tracking-wider text-slate-700 mb-3 flex items-center gap-1.5">
                    <Icon name="layers" class="w-3.5 h-3.5 text-amber-600" />
                    <span>{isNe ? 'चेतावनी नक्साहरू' : 'Hazard & Warning Maps'}</span>
                  </h5>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    {item.weatherMapImages.map((img, idx) => (
                      <a
                        href={getProxiedImageUrl(img.url)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/img block overflow-hidden rounded-xl border border-slate-200 bg-slate-50 hover:border-amber-500 transition"
                      >
                        <div class="aspect-4/3 overflow-hidden bg-white relative">
                          <img
                            src={getProxiedImageUrl(img.url)}
                            onerror={`this.onerror=null;this.src='${img.url}'`}
                            alt={`Warning Map ${idx + 1}`}
                            loading="lazy"
                            class="h-full w-full object-contain group-hover/img:scale-105 transition-transform duration-200"
                          />
                        </div>
                        <div class="p-2 bg-white border-t border-slate-100 text-center">
                          <span class="text-xs font-bold text-slate-700 block">
                            {isNe ? `दिन ${idx + 1} नक्सा` : `Day ${idx + 1} Map`}
                          </span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {item.content ? (
                <div
                  class="prose prose-sm max-w-none text-xs sm:text-sm text-slate-700 leading-relaxed space-y-2 border-t border-slate-100 pt-3"
                  set:html={rewriteContentImages(item.content)}
                />
              ) : item.description ? (
                <p class="text-xs sm:text-sm text-slate-700 leading-relaxed border-t border-slate-100 pt-3">
                  {item.description}
                </p>
              ) : !item.weatherMapImages?.length && (
                <p class="text-xs text-slate-500 italic">
                  {isNe ? 'थप विवरण उपलब्ध छैन।' : 'No additional details attached.'}
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  )}
</div>
