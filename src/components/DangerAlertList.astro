---
import type { RiverStation } from '../lib/dhm/types';
import Icon from './Icon.astro';

interface Props {
  dangerStations: RiverStation[];
  warningStations: RiverStation[];
  lang?: 'en' | 'ne';
}

const { dangerStations, warningStations, lang = 'en' } = Astro.props;
const isNe = lang === 'ne';
---

<div class="mb-8">
  <div class="mb-3 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-3 w-3 rounded-full bg-red-600 animate-ping"></span>
      <h2 class="text-lg font-black text-slate-900 tracking-tight">
        {isNe ? 'सक्रिय बाढी तथा जलसतह चेतावनी (Active Flood Alerts)' : 'Critical Flood Alerts & Danger Levels'}
      </h2>
    </div>
    <span class="rounded-lg bg-red-50 border border-red-200 px-2.5 py-1 text-xs font-bold text-red-700">
      {dangerStations.length} {isNe ? 'खतरा' : 'Danger'} • {warningStations.length} {isNe ? 'सतर्कता' : 'Warning'}
    </span>
  </div>

  {dangerStations.length > 0 || warningStations.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {dangerStations.map((st) => (
        <div class="rounded-2xl border-2 border-red-500 bg-red-50/40 p-4 shadow-sm relative overflow-hidden transition-all hover:shadow-md">
          <div class="absolute top-0 right-0 bg-red-600 text-white font-black text-[10px] uppercase tracking-wider px-3 py-1 rounded-bl-xl shadow-sm">
            {isNe ? 'खतरा तह पार (DANGER)' : 'HIGH DANGER'}
          </div>

          <div class="pr-20">
            <h3 class="text-base font-black text-slate-900 leading-snug">
              {st.name}
            </h3>
            <p class="text-xs font-semibold text-slate-600 mt-0.5">
              {st.basin} Basin • {st.district || 'District N/A'}
            </p>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-2 bg-white/90 rounded-xl p-3 border border-red-200">
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase">
                Current Water Level {((st.waterLevel && st.waterLevel > 50) || (st.dangerLevel && st.dangerLevel > 50)) && '(MSL)'}
              </span>
              <div class="text-xl font-black font-mono text-red-700">
                {st.waterLevel !== null ? `${st.waterLevel.toFixed(2)} m` : 'N/A'}
                {((st.waterLevel && st.waterLevel > 50) || (st.dangerLevel && st.dangerLevel > 50)) && (
                  <span class="text-[10px] font-semibold text-slate-500 block">Elevation Datum (m a.s.l.)</span>
                )}
              </div>
            </div>
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase">Danger Threshold</span>
              <div class="text-sm font-bold font-mono text-slate-700 mt-1">
                {st.dangerLevel !== null ? `${st.dangerLevel} m` : 'N/A'}
                {st.waterLevel !== null && st.dangerLevel !== null && st.waterLevel >= st.dangerLevel && (
                  <span class="text-[11px] font-bold text-red-600 block">
                    (+{(st.waterLevel - st.dangerLevel).toFixed(2)}m above!)
                  </span>
                )}
              </div>
            </div>
          </div>

          <div class="mt-3 flex items-center justify-between pt-2 border-t border-red-200/60 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-slate-500 font-medium">Trend:</span>
              {st.steady === 'RISING' ? (
                <span class="font-bold text-red-700 flex items-center gap-1">
                  <span>↑</span> {isNe ? 'बढ्दो क्रममा' : 'Rising Rapidly'}
                </span>
              ) : st.steady === 'FALLING' ? (
                <span class="font-bold text-blue-700 flex items-center gap-1">
                  <span>↓</span> {isNe ? 'घट्दो क्रममा' : 'Receding / Falling'}
                </span>
              ) : (
                <span class="font-medium text-slate-600">→ Steady</span>
              )}
            </div>

            {st.latitude && st.longitude && (
              <button
                type="button"
                onclick={`window.zoomToStation && window.zoomToStation(${st.id})`}
                class="cursor-pointer inline-flex items-center gap-1 text-[11px] font-bold text-red-700 hover:text-red-900 hover:underline"
              >
                <Icon name="map-pin" class="w-3 h-3 text-red-700" />
                <span>{isNe ? 'नक्सामा हेर्नुहोस्' : 'View on Map'}</span>
              </button>
            )}
          </div>
        </div>
      ))}

      {warningStations.map((st) => (
        <div class="rounded-2xl border border-amber-300 bg-amber-50/40 p-4 shadow-sm relative overflow-hidden transition-all hover:shadow-md">
          <div class="absolute top-0 right-0 bg-amber-500 text-white font-bold text-[10px] uppercase tracking-wider px-3 py-1 rounded-bl-xl shadow-sm">
            {isNe ? 'चेतावनी तह (WARNING)' : 'WARNING'}
          </div>

          <div class="pr-20">
            <h3 class="text-base font-black text-slate-900 leading-snug">
              {st.name}
            </h3>
            <p class="text-xs font-semibold text-slate-600 mt-0.5">
              {st.basin} Basin • {st.district || 'District N/A'}
            </p>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-2 bg-white/90 rounded-xl p-3 border border-amber-200">
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase">
                Current Water Level {((st.waterLevel && st.waterLevel > 50) || (st.warningLevel && st.warningLevel > 50)) && '(MSL)'}
              </span>
              <div class="text-xl font-black font-mono text-amber-700">
                {st.waterLevel !== null ? `${st.waterLevel.toFixed(2)} m` : 'N/A'}
                {((st.waterLevel && st.waterLevel > 50) || (st.warningLevel && st.warningLevel > 50)) && (
                  <span class="text-[10px] font-semibold text-slate-500 block">Elevation Datum (m a.s.l.)</span>
                )}
              </div>
            </div>
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase">Warning Threshold</span>
              <div class="text-sm font-bold font-mono text-slate-700 mt-1">
                {st.warningLevel !== null ? `${st.warningLevel} m` : 'N/A'}
              </div>
            </div>
          </div>

          <div class="mt-3 flex items-center justify-between pt-2 border-t border-amber-200/60 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-slate-500 font-medium">Trend:</span>
              {st.steady === 'RISING' ? (
                <span class="font-bold text-amber-800 flex items-center gap-1">
                  <span>↑</span> {isNe ? 'बढ्दो क्रममा' : 'Rising'}
                </span>
              ) : st.steady === 'FALLING' ? (
                <span class="font-bold text-blue-700 flex items-center gap-1">
                  <span>↓</span> {isNe ? 'घट्दो' : 'Falling'}
                </span>
              ) : (
                <span class="font-medium text-slate-600">→ Steady</span>
              )}
            </div>

            {st.latitude && st.longitude && (
              <button
                type="button"
                onclick={`window.zoomToStation && window.zoomToStation(${st.id})`}
                class="cursor-pointer inline-flex items-center gap-1 text-[11px] font-bold text-amber-800 hover:text-amber-950 hover:underline"
              >
                <Icon name="map-pin" class="w-3 h-3 text-amber-800" />
                <span>{isNe ? 'नक्सामा हेर्नुहोस्' : 'View on Map'}</span>
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-6 text-center">
      <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mb-2">
        <Icon name="check" class="w-6 h-6 text-emerald-700" />
      </div>
      <h3 class="text-base font-bold text-emerald-900">
        {isNe ? 'हाल कुनै पनि नदीमा खतराको तह पार भएको छैन' : 'No Active River Flood Dangers'}
      </h3>
      <p class="text-xs text-emerald-700 mt-1 max-w-md mx-auto">
        {isNe
          ? 'नेपालका सबै ३३६ जलमापन केन्द्रहरूमा नदीको सतह खतरा र चेतावनी तहभन्दा तल छ।'
          : 'All 336 hydrological river monitoring stations are currently flowing safely below warning thresholds.'}
      </p>
    </div>
  )}
</div>
