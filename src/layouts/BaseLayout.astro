---
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ne';
  canonicalPath?: string;
  schema?: Record<string, any> | Record<string, any>[];
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'en',
  canonicalPath = Astro.url.pathname,
  schema,
  ogImage = 'https://weather.topnepali.com/favicon.svg',
} = Astro.props;

const isNe = lang === 'ne';
const siteUrl = 'https://weather.topnepali.com';

// Clean trailing slash normalization
const cleanPath = canonicalPath.endsWith('/') && canonicalPath !== '/' ? canonicalPath.slice(0, -1) : canonicalPath;
const canonicalUrl = `${siteUrl}${cleanPath}`;

// Determine equivalent cross-language URLs for hreflang & language toggle
const enPath = isNe ? (cleanPath.replace(/^\/ne(\/|$)/, '/') || '/') : cleanPath;
const nePath = isNe ? cleanPath : (cleanPath === '/' ? '/ne' : `/ne${cleanPath}`);

const host = Astro.url.hostname;
const isProduction = host === 'weather.topnepali.com';
const allowAdSense = isProduction && !isNe;
const allowTrackers = isProduction;

// Schema.org Structured Data
const defaultSchemas: Record<string, any>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Nepal Weather & River Watch',
    alternateName: ['Nepal Weather', 'Top Nepali Weather', 'नेपाल जल तथा मौसम'],
    url: siteUrl,
    inLanguage: ['en', 'ne'],
    publisher: {
      '@type': 'Organization',
      name: 'Top Nepali',
      url: 'https://topnepali.com',
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon.svg`,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': cleanPath.includes('/about')
      ? 'AboutPage'
      : cleanPath.includes('/contact')
      ? 'ContactPage'
      : 'WebPage',
    name: title,
    description: description,
    url: canonicalUrl,
    inLanguage: lang,
    isPartOf: {
      '@type': 'WebSite',
      url: siteUrl,
    },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: isNe ? 'गृहपृष्ठ' : 'Home',
          item: isNe ? `${siteUrl}/ne` : siteUrl,
        },
        ...(cleanPath !== '/' && cleanPath !== '/ne'
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: title.split('|')[0].trim(),
                item: canonicalUrl,
              },
            ]
          : []),
      ],
    },
  },
];

const allSchemas = [
  ...defaultSchemas,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-slate-50 text-slate-900 antialiased font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="ne" href={`${siteUrl}${nePath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${enPath}`} />

    <!-- Robots directive based on host environment -->
    {isProduction ? (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    ) : (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
        <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
      </>
    )}

    <!-- Open Graph & Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nepal Weather & River Watch | Top Nepali" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={isNe ? 'ne_NP' : 'en_US'} />
    <meta property="og:locale:alternate" content={isNe ? 'en_US' : 'ne_NP'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@topnepali" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

    <!-- Google AdSense (Strictly English Production Only; zero ads on /ne or preview) -->
    {allowAdSense && (
      <>
        <meta name="google-adsense-account" content="ca-pub-5410507143596599" />
        <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
        <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
        <script
          is:inline
          defer
          crossorigin="anonymous"
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5410507143596599"
        ></script>
      </>
    )}
    {!allowAdSense && (
      <script is:inline>
        window.adsbygoogle = Object.freeze({ push: function() {}, loaded: true });
        try {
          var h = window.location.hostname.toLowerCase();
          if (h.includes('workers.dev') || h.includes('pages.dev') || h.includes('localhost') || h === '127.0.0.1') {
            document.querySelectorAll('ins.adsbygoogle, script[src*="adsbygoogle"], meta[name="google-adsense-account"]').forEach(function(el) {
              el.remove();
            });
          }
        } catch(e) {}
      </script>
    )}

    <!-- Google Analytics GA4 (Production Only; English & Nepali) -->
    {allowTrackers && (
      <>
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K2R0GSQE0M"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-K2R0GSQE0M');
        </script>
      </>
    )}

    <!-- Solid Unicode System Font Stack & Tailwind Styles -->
    <style is:global>
      @import "tailwindcss";

      :root {
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans', 'Noto Sans Devanagari', 'Helvetica Neue', Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
      }

      html {
        font-family: var(--font-sans);
        -webkit-text-size-adjust: 100%;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        color-scheme: light;
      }

      body {
        font-family: var(--font-sans);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 pt-[104px] lg:pt-[72px] selection:bg-blue-600 selection:text-white">
    <!-- Header Navigation (Directional Auto-Hide on Scroll Down, Reveal on Scroll Up) -->
    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 ease-in-out border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-2xs"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href={isNe ? '/ne' : '/'} class="flex items-center gap-3 font-black text-slate-900 tracking-tight group">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white shadow-md shadow-blue-500/25 group-hover:bg-blue-700 transition">
            <Icon name="waves" class="w-5 h-5 text-white" />
          </span>
          <div class="flex flex-col leading-tight">
            <span class="text-base font-black tracking-tight text-blue-700">
              {isNe ? 'जल तथा मौसम' : 'NEPAL WEATHER'}
            </span>
            <span class="text-xs font-semibold text-slate-500">
              {isNe ? 'नदी तथा बाढी पूर्वसूचना' : 'River & Flood Watch'}
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-1 text-sm font-bold text-slate-600">
          <a
            href={isNe ? '/ne' : '/'}
            class={`px-3 py-2 rounded-lg transition-colors ${cleanPath === '/' || cleanPath === '/ne' ? 'bg-blue-50 text-blue-700 font-extrabold' : 'hover:bg-slate-100 text-slate-700'}`}
          >
            {isNe ? 'गृहपृष्ठ' : 'Home'}
          </a>
          <a
            href={isNe ? '/ne/special-weather' : '/special-weather'}
            class={`px-3 py-2 rounded-lg transition-colors flex items-center gap-1.5 ${cleanPath.includes('special-weather') ? 'bg-amber-50 text-amber-800 font-extrabold' : 'hover:bg-amber-50/60 text-slate-700'}`}
          >
            <span class="inline-block h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
            {isNe ? 'विशेष चेतावनी' : 'Special Alerts'}
          </a>
          <a
            href={isNe ? '/ne/city-forecast' : '/city-forecast'}
            class={`px-3 py-2 rounded-lg transition-colors ${cleanPath.includes('city-forecast') || cleanPath.includes('weather') && !cleanPath.includes('special') ? 'bg-blue-50 text-blue-700 font-extrabold' : 'hover:bg-slate-100 text-slate-700'}`}
          >
            {isNe ? 'मौसम' : 'Weather'}
          </a>
          <a
            href={isNe ? '/ne/river-watch' : '/river-watch'}
            class={`px-3 py-2 rounded-lg transition-colors ${cleanPath.includes('river-watch') ? 'bg-blue-50 text-blue-700 font-extrabold' : 'hover:bg-slate-100 text-slate-700'}`}
          >
            {isNe ? 'नदी बाढी' : 'River Watch'}
          </a>
          <a
            href={isNe ? '/ne/bulletin' : '/bulletin'}
            class={`px-3 py-2 rounded-lg transition-colors ${cleanPath.includes('bulletin') ? 'bg-blue-50 text-blue-700 font-extrabold' : 'hover:bg-slate-100 text-slate-700'}`}
          >
            {isNe ? '३ दिने बुलेटिन' : '3-Day Bulletin'}
          </a>
          <a
            href={isNe ? '/ne/nwp' : '/nwp'}
            class={`px-3 py-2 rounded-lg transition-colors ${cleanPath.includes('nwp') ? 'bg-blue-50 text-blue-700 font-extrabold' : 'hover:bg-slate-100 text-slate-700'}`}
          >
            {isNe ? 'NWP मोडेल' : 'NWP Models'}
          </a>
          <a
            href={isNe ? '/ne/press-releases' : '/press-releases'}
            class={`px-3 py-2 rounded-lg transition-colors ${cleanPath.includes('press-releases') ? 'bg-blue-50 text-blue-700 font-extrabold' : 'hover:bg-slate-100 text-slate-700'}`}
          >
            {isNe ? 'प्रेस विज्ञप्ति' : 'Press'}
          </a>
          <a
            href={isNe ? '/ne/mountaineering' : '/mountaineering'}
            class={`px-3 py-2 rounded-lg transition-colors ${cleanPath.includes('mountaineering') ? 'bg-blue-50 text-blue-700 font-extrabold' : 'hover:bg-slate-100 text-slate-700'}`}
          >
            {isNe ? 'हिमाल' : 'Peaks'}
          </a>
        </nav>

        <!-- Language Switcher & Live indicator -->
        <div class="flex items-center gap-2">
          <a
            href={isNe ? enPath : nePath}
            class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-xs sm:text-sm font-bold text-slate-700 shadow-2xs transition hover:bg-slate-100 hover:text-slate-900"
            title={isNe ? 'Switch to English' : 'नेपाली भाषामा हेर्नुहोस्'}
          >
            <Icon name="compass" class="w-3.5 h-3.5 text-slate-500" />
            <span>{isNe ? 'English' : 'नेपाली'}</span>
          </a>
        </div>
      </div>

      <!-- Mobile Navigation sub-bar with crisp font sizing -->
      <div class="flex lg:hidden overflow-x-auto border-t border-slate-100 px-3 py-2 text-xs font-bold gap-1 bg-slate-50/90 no-scrollbar">
        <a href={isNe ? '/ne' : '/'} class={`px-2.5 py-1.5 rounded-lg shrink-0 ${cleanPath === '/' || cleanPath === '/ne' ? 'bg-white shadow-2xs text-blue-600 font-black' : 'text-slate-700'}`}>
          {isNe ? 'गृहपृष्ठ' : 'Home'}
        </a>
        <a href={isNe ? '/ne/special-weather' : '/special-weather'} class={`px-2.5 py-1.5 rounded-lg shrink-0 flex items-center gap-1 ${cleanPath.includes('special-weather') ? 'bg-amber-100 text-amber-900 font-black shadow-2xs' : 'text-amber-800'}`}>
          <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          {isNe ? 'विशेष चेतावनी' : 'Alerts'}
        </a>
        <a href={isNe ? '/ne/city-forecast' : '/city-forecast'} class={`px-2.5 py-1.5 rounded-lg shrink-0 ${cleanPath.includes('city-forecast') || cleanPath.includes('weather') && !cleanPath.includes('special') ? 'bg-white shadow-2xs text-blue-600 font-black' : 'text-slate-700'}`}>
          {isNe ? 'मौसम' : 'Weather'}
        </a>
        <a href={isNe ? '/ne/river-watch' : '/river-watch'} class={`px-2.5 py-1.5 rounded-lg shrink-0 ${cleanPath.includes('river-watch') ? 'bg-white shadow-2xs text-blue-600 font-black' : 'text-slate-700'}`}>
          {isNe ? 'नदी बाढी' : 'Rivers'}
        </a>
        <a href={isNe ? '/ne/bulletin' : '/bulletin'} class={`px-2.5 py-1.5 rounded-lg shrink-0 ${cleanPath.includes('bulletin') ? 'bg-white shadow-2xs text-blue-600 font-black' : 'text-slate-700'}`}>
          {isNe ? '३-दिने' : '3-Day'}
        </a>
        <a href={isNe ? '/ne/nwp' : '/nwp'} class={`px-2.5 py-1.5 rounded-lg shrink-0 ${cleanPath.includes('nwp') ? 'bg-white shadow-2xs text-blue-600 font-black' : 'text-slate-700'}`}>
          {isNe ? 'NWP' : 'NWP'}
        </a>
        <a href={isNe ? '/ne/press-releases' : '/press-releases'} class={`px-2.5 py-1.5 rounded-lg shrink-0 ${cleanPath.includes('press-releases') ? 'bg-white shadow-2xs text-blue-600 font-black' : 'text-slate-700'}`}>
          {isNe ? 'विज्ञप्ति' : 'Press'}
        </a>
        <a href={isNe ? '/ne/mountaineering' : '/mountaineering'} class={`px-2.5 py-1.5 rounded-lg shrink-0 ${cleanPath.includes('mountaineering') ? 'bg-white shadow-2xs text-blue-600 font-black' : 'text-slate-700'}`}>
          {isNe ? 'हिमाल' : 'Peaks'}
        </a>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">
      <slot />
    </main>

    <!-- Multi-Column Responsive Footer -->
    <footer class="mt-16 border-t border-slate-200 bg-white pt-10 pb-8 text-xs text-slate-500">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <!-- 3-Column Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-slate-100">
          <!-- Column 1: Brand & Regional Telemetry Authority -->
          <div class="space-y-3">
            <div class="flex items-center gap-2.5">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white shadow-md shadow-blue-500/20">
                <Icon name="waves" class="w-4 h-4 text-white" />
              </span>
              <div>
                <span class="text-sm font-black text-slate-900 tracking-tight block">
                  {isNe ? 'नेपाल जल तथा मौसम पोर्टल' : 'Nepal Weather & River Watch'}
                </span>
                <span class="text-[11px] font-semibold text-blue-700">
                  {isNe ? 'प्रत्यक्ष बाढी तथा मौसमी पूर्वसूचना' : 'Real-Time Hydrology & Meteorology'}
                </span>
              </div>
            </div>
            <p class="text-[11px] leading-relaxed text-slate-500">
              {isNe
                ? 'जल तथा मौसम विज्ञान विभाग (DHM) र मौसम पूर्वानुमान महाशाखा (MFD) को प्रत्यक्ष सेन्सर तथ्याङ्क। नेपालका ७ प्रदेश, ७७ जिल्ला र १६५ नदी बेसिनहरूको निरन्तर डिजिटल पूर्वसूचना।'
                : 'Automated real-time early warning network providing live telemetry across 165 river basins, 77 districts, 7 provinces, and 8,000m+ Himalayan climbing peaks using official DHM & MFD sensor feeds.'}
            </p>
            <div class="pt-1 flex items-center gap-2 text-[11px] font-bold text-slate-600">
              <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>{isNe ? 'प्रणाली सक्रिय (Edge Network)' : 'Edge Telemetry Network Active'}</span>
            </div>
          </div>

          <!-- Column 2: Observatories & Forecast Hubs -->
          <div>
            <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 mb-3 flex items-center gap-1.5">
              <Icon name="layers" class="w-3.5 h-3.5 text-blue-600" />
              <span>{isNe ? 'मुख्य मौसमी तथा बाढी केन्द्र' : 'Observatories & Forecast Hubs'}</span>
            </h4>
            <ul class="space-y-2 text-[11px]">
              <li>
                <a href={isNe ? '/ne/river-watch' : '/river-watch'} class="hover:text-blue-600 hover:underline flex items-center justify-between">
                  <span>{isNe ? 'प्रत्यक्ष नदी जलसतह तथा बाढी निगरानी' : 'Live River Watch & Flood Alerts'}</span>
                  <span class="text-slate-300">↗</span>
                </a>
              </li>
              <li>
                <a href={isNe ? '/ne/special-weather' : '/special-weather'} class="hover:text-blue-600 hover:underline flex items-center justify-between">
                  <span>{isNe ? 'विशेष मौसमी चेतावनी तथा नक्सा' : 'Special Weather & Hazard Bulletins'}</span>
                  <span class="text-slate-300">↗</span>
                </a>
              </li>
              <li>
                <a href={isNe ? '/ne/mountaineering' : '/mountaineering'} class="hover:text-blue-600 hover:underline flex items-center justify-between">
                  <span>{isNe ? 'हिमाल आरोहण तथा उच्च हिमाली तह' : 'High Himalayan Peaks & Telemetry'}</span>
                  <span class="text-slate-300">↗</span>
                </a>
              </li>
              <li>
                <a href={isNe ? '/ne/city-forecast' : '/city-forecast'} class="hover:text-blue-600 hover:underline flex items-center justify-between">
                  <span>{isNe ? '१९ प्रमुख सहरहरूको मौसमी पूर्वानुमान' : '19 Major Cities Weather Forecast'}</span>
                  <span class="text-slate-300">↗</span>
                </a>
              </li>
              <li>
                <a href={isNe ? '/ne/bulletin' : '/bulletin'} class="hover:text-blue-600 hover:underline flex items-center justify-between">
                  <span>{isNe ? '३ दिने राष्ट्रिय मौसमी बुलेटिन' : '3-Day Synoptic Weather Bulletins'}</span>
                  <span class="text-slate-300">↗</span>
                </a>
              </li>
              <li>
                <a href={isNe ? '/ne/nwp' : '/nwp'} class="hover:text-blue-600 hover:underline flex items-center justify-between">
                  <span>{isNe ? 'NWP गणितीय मौसम मोडेल नक्सा' : 'NWP Numerical Weather Prediction'}</span>
                  <span class="text-slate-300">↗</span>
                </a>
              </li>
              <li>
                <a href={isNe ? '/ne/press-releases' : '/press-releases'} class="hover:text-blue-600 hover:underline flex items-center justify-between">
                  <span>{isNe ? 'आधिकारिक सरकारी प्रेस विज्ञप्ति' : 'Official DHM Press Releases'}</span>
                  <span class="text-slate-300">↗</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Column 3: Emergency Hotlines & Contacts -->
          <div>
            <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 mb-3 flex items-center gap-1.5">
              <Icon name="alert-triangle" class="w-3.5 h-3.5 text-red-600" />
              <span>{isNe ? 'आपतकालीन हटलाइन तथा सहयोग' : 'Emergency Helplines & Data'}</span>
            </h4>
            <div class="space-y-2.5 text-[11px]">
              <div class="rounded-xl border border-red-200 bg-red-50/60 p-2.5">
                <span class="font-bold text-red-900 block">
                  {isNe ? 'बाढी आपतकालीन हटलाइन (Toll Free):' : 'Emergency Flood Toll-Free Hotline:'}
                </span>
                <span class="text-base font-black text-red-700 tracking-wider">1155</span>
                <p class="text-[10px] text-red-800/80 mt-0.5">
                  {isNe ? 'मनसुन तथा बाढी जोखिममा २४ सै घण्टा खुला' : '24/7 National Emergency Flood Siren Support'}
                </p>
              </div>
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5">
                <span class="font-bold text-slate-800 block">
                  {isNe ? 'मौसम पूर्वानुमान महाशाखा सोधपुछ:' : 'MFD Weather Forecast Inquiries:'}
                </span>
                <span class="font-mono font-bold text-slate-900">01-4113191 / 01-4113192</span>
              </div>
              <div class="flex items-center justify-between pt-1 text-[10px] text-slate-400">
                <a href="/api/data" class="hover:text-blue-600 hover:underline">
                  {isNe ? 'ओपन डाटा API (JSON)' : 'Open Data Feed (JSON)'}
                </a>
                <a href={isNe ? '/ne/sitemap' : '/sitemap'} class="hover:text-blue-600 hover:underline">
                  {isNe ? 'दृश्य साइटम्याप' : 'Visual Sitemap'}
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Responsive Footerbar -->
        <div class="pt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-[11px]">
