{
  "name": "nepal-weather",
  "type": "module",
  "version": "1.0.0",
  "description": "High-Performance Edge-Cached Nepal Weather & River Flood Warning Portal",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro-cli.js dev --host 0.0.0.0 --port 3000",
    "start": "node ./dist/server/entry.mjs",
    "build": "node scripts/astro-cli.js build --cloudflare",
    "build:cf": "node scripts/astro-cli.js build --cloudflare",
    "build:node": "node scripts/astro-cli.js build --node",
    "deploy:pages": "npm run build && node /data/data/com.termux/files/home/.npm/_npx/32026684e21afda6/node_modules/wrangler/bin/wrangler.js pages deploy dist --project-name weather",
    "test": "npm run build:node && node test-server-integration.mjs",
    "preview": "node scripts/astro-cli.js preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/node": "^11.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3",
